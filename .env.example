# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database ---------------------------------------------------------------
# Used by the local SQL Server container and API database connections.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# Host-based API development connects to SQL Server through localhost.
# ASP.NET Core reads configuration from environment variables, where "__" means
# "nested section". Setting this overrides ConnectionStrings:Default from
# apps/api/src/SupportDesk.Presentation/appsettings.Development.json.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# The Compose API uses the same database credentials but connects to the SQL
# Server service hostname "sqlserver". Compose constructs that connection string.
# The Docker API runs in Development so startup applies migrations and demo seeds.
ASPNETCORE_ENVIRONMENT=Development

# Non-production password fixture used only to hash credentials for the six seeded agents.
# Supply this environment variable to the API process when running locally; dotnet does not
# automatically load this .env.example file.
DevelopmentCredentials__Password=LocalDevOnly!2026

# JWT settings are supplied to the API at runtime by Docker Compose and may also
# be used for local API development. The signing key must be replaced with a
# random value of at least 32 bytes before starting the API. Keep real values in
# the untracked .env file, never in tracked files or the image.
Jwt__Issuer=NorthwindSupportDesk
Jwt__Audience=NorthwindSupportDesk
Jwt__SigningKey=replace-with-a-random-secret-of-at-least-32-bytes
Jwt__TokenLifetimeMinutes=60

# Copy this file to .env and replace development-only examples and placeholders.
# Compose requires the values above; .env.example itself is not loaded automatically.
